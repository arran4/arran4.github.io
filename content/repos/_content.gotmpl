{{/* Get remote data. */}}
{{ $data := slice }}
{{ $url := "https://api.github.com/users/arran4/repos" }}
{{ $githubToken := getenv "GITHUB_TOKEN" }}
{{ $headers := dict }}
{{ if $githubToken }}
  {{ $headers = dict "Authorization" (printf "token %s" $githubToken) }}
{{ end }}
{{ $perPage := 100 }}
{{ $maxPages := 20 }}
{{ $morePages := true }}

{{ range seq 1 $maxPages }}
  {{ if $morePages }}
    {{ $pagedUrl := printf "%s?page=%d&per_page=%d" $url . $perPage }}
    {{ $result := try (resources.GetRemote $pagedUrl (dict "headers" $headers)) }}
    {{ if $result.Err }}
      {{ errorf "Unable to get remote resource %s: %s" $pagedUrl $result.Err }}
    {{ else if $result.Value }}
      {{ $pageData := $result.Value | transform.Unmarshal }}
      {{ $data = $data | append $pageData }}
      {{ if lt (len $pageData) $perPage }}
        {{ $morePages = false }}
      {{ end }}
    {{ else }}
      {{ errorf "Unable to get remote resource %s" $pagedUrl }}
    {{ end }}
  {{ end }}
{{ end }}


{{/* Add pages and page resources. */}}
{{ range $data }}

  {{/* Resolve the actual published Pages URL, including custom domains. */}}
  {{ $pagesURL := "" }}
  {{ if .has_pages }}
    {{ $pagesAPI := printf "https://api.github.com/repos/%s/pages" .full_name }}
    {{ $pagesResult := try (resources.GetRemote $pagesAPI (dict "headers" $headers)) }}
    {{ if $pagesResult.Err }}
      {{ errorf "Unable to resolve GitHub Pages URL for %s: %s" .full_name $pagesResult.Err }}
    {{ else if not $pagesResult.Value }}
      {{ errorf "GitHub Pages API returned no data for %s" .full_name }}
    {{ else }}
      {{ $pagesData := $pagesResult.Value | transform.Unmarshal }}
      {{ if and $pagesData.public $pagesData.html_url }}
        {{ $pagesURL = $pagesData.html_url }}
      {{ else if not $pagesData.public }}
        {{ warnf "Omitting non-public GitHub Pages site for %s" .full_name }}
      {{ else }}
        {{ errorf "GitHub Pages URL missing for %s" .full_name }}
      {{ end }}
    {{ end }}
  {{ end }}

  {{/* Add page. */}}
  {{ $content := dict "mediaType" "text/markdown" "value" .description }}
  {{ $dates := dict "date" (time.AsTime .updated_at) }}
  {{ $heroUrl := printf "https://opengraph.githubassets.com/%s/%s" .default_branch .full_name }}
  {{ $repotags := (slice "Untagged") }}
  {{ if gt (len .topics) 0 }}
    {{ $repotags = .topics }}
  {{ end }}
  {{ $params := dict
        "owner" .owner
        "language" .language
        "homepage" .homepage
        "has_pages" .has_pages
        "pages_url" $pagesURL
        "html_url" .html_url
        "repo-tags" $repotags
        "tags" (slice "Repos")
        "categories" (slice "Repos")
        "default_branch" .default_branch
        "heroUrl" $heroUrl
        "full_name" .full_name
        "private" .private
        "archived" .archived
        "fork" .fork
      }}
  {{ $page := dict
    "content" $content
    "dates" $dates
    "kind" "page"
    "params" $params
    "path" .node_id
    "title" .name
  }}
  {{ if not (or .private ) }}
    {{ $.AddPage $page }}
  {{ end }}
{{ end }}

