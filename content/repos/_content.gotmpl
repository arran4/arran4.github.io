{{/* Get remote data. */}}
{{ $data := slice }}
{{ $url := "https://api.github.com/users/arran4/repos" }}
{{/* Public user repository endpoint. Never send credentials with these requests. */}}
{{ $headers := dict }}
{{ $perPage := 100 }}
{{ $maxPages := 20 }}
{{ $morePages := true }}

{{ range seq 1 $maxPages }}
  {{ if $morePages }}
    {{ $pagedUrl := printf "%s?page=%d&per_page=%d" $url . $perPage }}
    {{ $result := try (resources.GetRemote $pagedUrl (dict "headers" $headers)) }}
    {{ if $result.Err }}
      {{ errorf "Unable to get remote resource %s: %s" $pagedUrl $result.Err }}
    {{ else if $result.Value }}
      {{ $pageData := $result.Value | transform.Unmarshal }}
      {{ $data = $data | append $pageData }}
      {{ if lt (len $pageData) $perPage }}
        {{ $morePages = false }}
      {{ end }}
    {{ else }}
      {{ errorf "Unable to get remote resource %s" $pagedUrl }}
    {{ end }}
  {{ end }}
{{ end }}


{{/* Add pages and page resources. */}}
{{ range $data }}

  {{/* Published URL comes only from a reviewed, static public-repository inventory. */}}
  {{ $pagesURL := "" }}
  {{ $knownSites := where site.Data.pages.sites "repo" .full_name }}
  {{ if gt (len $knownSites) 0 }}
    {{ $pagesURL = (index $knownSites 0).url }}
  {{ end }}

  {{/* Add page. */}}
  {{ $content := dict "mediaType" "text/markdown" "value" .description }}
  {{ $dates := dict "date" (time.AsTime .updated_at) }}
  {{ $heroUrl := printf "https://opengraph.githubassets.com/%s/%s" .default_branch .full_name }}
  {{ $repotags := (slice "Untagged") }}
  {{ if gt (len .topics) 0 }}
    {{ $repotags = .topics }}
  {{ end }}
  {{ $params := dict
        "owner" .owner
        "language" .language
        "homepage" .homepage
        "has_pages" .has_pages
        "pages_url" $pagesURL
        "html_url" .html_url
        "repo-tags" $repotags
        "tags" (slice "Repos")
        "categories" (slice "Repos")
        "default_branch" .default_branch
        "heroUrl" $heroUrl
        "full_name" .full_name
        "private" .private
        "archived" .archived
        "fork" .fork
      }}
  {{ $page := dict
    "content" $content
    "dates" $dates
    "kind" "page"
    "params" $params
    "path" .node_id
    "title" .name
  }}
  {{ if not (or .private ) }}
    {{ $.AddPage $page }}
  {{ end }}
{{ end }}

