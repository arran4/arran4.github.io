{{/* Once bootstrapped, the reviewed on-disk snapshot is the only source used
     for repository pages. The live path is transitional until the first daily
     snapshot pull request has been merged. */}}
{{ $data := slice }}
{{ with site.Data.github }}
  {{ with .repositories }}
    {{ $data = . }}
  {{ end }}
{{ end }}

{{ if eq (len $data) 0 }}
  {{ warnf "Public GitHub repositories snapshot not bootstrapped yet; using temporary legacy API/fallback" }}
  {{ $url := "https://api.github.com/users/arran4/repos" }}
  {{ $perPage := 100 }}
  {{ $maxPages := 20 }}
  {{ $morePages := true }}
  {{ $useFallback := eq (os.Getenv "HUGO_REPOS_OFFLINE") "1" }}
  {{ if not $useFallback }}
    {{ range seq 1 $maxPages }}
      {{ if $morePages }}
        {{ $pagedUrl := printf "%s?page=%d&per_page=%d" $url . $perPage }}
        {{ $result := try (resources.GetRemote $pagedUrl) }}
        {{ if $result.Err }}
          {{ warnf "Legacy public repository API unavailable at %s: %s" $pagedUrl $result.Err }}
          {{ $useFallback = true }}
          {{ $morePages = false }}
        {{ else if $result.Value }}
          {{ $pageData := $result.Value | transform.Unmarshal }}
          {{ $data = $data | append $pageData }}
          {{ if lt (len $pageData) $perPage }}
            {{ $morePages = false }}
          {{ end }}
        {{ else }}
          {{ $useFallback = true }}
          {{ $morePages = false }}
        {{ end }}
      {{ end }}
    {{ end }}
  {{ end }}

  {{ if eq (len $data) 0 }}{{ $useFallback = true }}{{ end }}
  {{ if $useFallback }}
    {{ $data = slice }}
    {{ $owner := dict "login" "arran4" "html_url" "https://github.com/arran4" "avatar_url" "https://github.com/arran4.png" }}
    {{ range site.Data.pages.sites }}
      {{ $repoName := path.Base .repo }}
      {{ $repo := dict
        "node_id" (printf "fallback-%s" $repoName)
        "name" $repoName
        "full_name" .repo
        "description" .summary
        "updated_at" "2026-11-17T00:00:00Z"
        "owner" $owner
        "language" ""
        "homepage" .url
        "has_pages" true
        "html_url" (printf "https://github.com/%s" .repo)
        "default_branch" "main"
        "topics" (slice)
        "private" false
        "archived" .archived
        "fork" false
      }}
      {{ $data = $data | append $repo }}
    {{ end }}
  {{ end }}
{{ end }}

{{/* Add pages and page resources. */}}
{{ range $data }}

  {{/* Published URL comes only from a reviewed, static public-repository inventory. */}}
  {{ $pagesURL := "" }}
  {{ $knownSites := where site.Data.pages.sites "repo" .full_name }}
  {{ if gt (len $knownSites) 0 }}
    {{ $pagesURL = (index $knownSites 0).url }}
  {{ end }}

  {{/* Add page. */}}
  {{ $content := dict "mediaType" "text/markdown" "value" .description }}
  {{ $dates := dict "date" (time.AsTime .updated_at) }}
  {{ $heroUrl := printf "https://opengraph.githubassets.com/%s/%s" .default_branch .full_name }}
  {{ $repotags := (slice "Untagged") }}
  {{ if gt (len .topics) 0 }}
    {{ $repotags = .topics }}
  {{ end }}
  {{ $params := dict
        "owner" .owner
        "language" .language
        "homepage" .homepage
        "has_pages" .has_pages
        "pages_url" $pagesURL
        "html_url" .html_url
        "repo-tags" $repotags
        "tags" (slice "Repos")
        "categories" (slice "Repos")
        "default_branch" .default_branch
        "heroUrl" $heroUrl
        "full_name" .full_name
        "private" .private
        "archived" .archived
        "fork" .fork
      }}
  {{ $page := dict
    "content" $content
    "dates" $dates
    "kind" "page"
    "params" $params
    "path" .node_id
    "title" .name
  }}
  {{ if not (or .private ) }}
    {{ $.AddPage $page }}
  {{ end }}
{{ end }}

