{{/* Prefer the stable checked-in snapshot. The API fallback exists only
     until the first daily starred-repository refresh PR has been merged. */}}
{{ $data := slice }}
{{ with site.Data.github }}
  {{ with .starred }}
    {{ $data = . }}
  {{ end }}
{{ end }}
{{ if eq (len $data) 0 }}
  {{ warnf "Public GitHub starred snapshot not bootstrapped yet; using temporary legacy API" }}
  {{ $url := "https://api.github.com/users/arran4/starred" }}
  {{ $perPage := 100 }}
  {{ $maxPages := 20 }}
  {{ $morePages := true }}
  {{ range seq 1 $maxPages }}
    {{ if $morePages }}
      {{ $pagedUrl := printf "%s?page=%d&per_page=%d" $url . $perPage }}
      {{ $result := try (resources.GetRemote $pagedUrl) }}
      {{ if $result.Err }}
        {{ warnf "Legacy starred endpoint unavailable at %s: %s" $pagedUrl $result.Err }}
        {{ $morePages = false }}
      {{ else if $result.Value }}
        {{ $pageData := $result.Value | transform.Unmarshal }}
        {{ $data = $data | append $pageData }}
        {{ if lt (len $pageData) $perPage }}
          {{ $morePages = false }}
        {{ end }}
      {{ else }}
        {{ $morePages = false }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}

{{/* Add pages and page resources. */}}
{{ range $data }}

  {{/* Add page. */}}
  {{ $content := dict "mediaType" "text/markdown" "value" .description }}
  {{ $dates := dict "date" (time.AsTime .updated_at) }}
  {{ $heroUrl := printf "https://opengraph.githubassets.com/%s/%s" .default_branch .full_name }}
  {{ $startags := (slice "Untagged") }}
  {{ if gt (len .topics) 0 }}
    {{ $startags = .topics }}
  {{ end }}
  {{ $params := dict
        "owner" .owner
        "language" .language
        "homepage" .homepage
        "html_url" .html_url
        "star-tags" $startags
        "tags" (slice "Stars")
        "categories" (slice "Stars")
        "default_branch" .default_branch
        "heroUrl" $heroUrl
      }}
  {{ $page := dict
    "content" $content
    "dates" $dates
    "kind" "page"
    "params" $params
    "path" .node_id
    "title" .full_name
  }}
  {{ $.AddPage $page }}

{{ end }}

