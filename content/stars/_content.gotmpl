{{/* Get remote data. */}}
{{ $data := slice }}
{{ $url := "https://api.github.com/users/arran4/starred" }}
{{/* Public starred repositories only. Do not authenticate these requests. */}}
{{ $headers := dict }}
{{ $perPage := 100 }}
{{ $maxPages := 20 }}
{{ $morePages := true }}

{{ range seq 1 $maxPages }}
  {{ if $morePages }}
    {{ $pagedUrl := printf "%s?page=%d&per_page=%d" $url . $perPage }}
    {{ $result := try (resources.GetRemote $pagedUrl (dict "headers" $headers)) }}
    {{ if $result.Err }}
      {{ warnf "Public GitHub starred endpoint unavailable at %s: %s; published list may be incomplete (%d entries fetched)" $pagedUrl $result.Err (len $data) }}
      {{ $morePages = false }}
    {{ else if $result.Value }}
      {{ $pageData := $result.Value | transform.Unmarshal }}
      {{ $data = $data | append $pageData }}
      {{ if lt (len $pageData) $perPage }}
        {{ $morePages = false }}
      {{ end }}
    {{ else }}
      {{ warnf "Public GitHub starred endpoint returned no data at %s; published list may be incomplete (%d entries fetched)" $pagedUrl (len $data) }}
      {{ $morePages = false }}
    {{ end }}
  {{ end }}
{{ end }}


{{/* Add pages and page resources. */}}
{{ range $data }}

  {{/* Add page. */}}
  {{ $content := dict "mediaType" "text/markdown" "value" .description }}
  {{ $dates := dict "date" (time.AsTime .updated_at) }}
  {{ $heroUrl := printf "https://opengraph.githubassets.com/%s/%s" .default_branch .full_name }}
  {{ $startags := (slice "Untagged") }}
  {{ if gt (len .topics) 0 }}
    {{ $startags = .topics }}
  {{ end }}
  {{ $params := dict
        "owner" .owner
        "language" .language
        "homepage" .homepage
        "html_url" .html_url
        "star-tags" $startags
        "tags" (slice "Stars")
        "categories" (slice "Stars")
        "default_branch" .default_branch
        "heroUrl" $heroUrl
      }}
  {{ $page := dict
    "content" $content
    "dates" $dates
    "kind" "page"
    "params" $params
    "path" .node_id
    "title" .full_name
  }}
  {{ $.AddPage $page }}

{{ end }}

